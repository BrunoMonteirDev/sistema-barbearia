// Papel do schema: descreve modelos, campos, relações e restrições que definem a estrutura persistida pelo PostgreSQL.
generator client {
  // Gera o cliente usado pelo backend para consultar o banco via Prisma.
  provider = "prisma-client-js"
}

datasource db {
  // A URL da conexão é fornecida pelo ambiente em prisma.config.js.
  provider = "postgresql"
}

// Conta de cliente, funcionário ou administrador; o nível controla permissões no backend.
model Usuario {
  id              String        @id @default(uuid())
  nome            String
  email           String        @unique
  telefone        String?
  dataNascimento  DateTime?     @map("data_nascimento")
  senhaHash       String?       @map("senha_hash")
  // O código vai por e-mail; somente seu HMAC e prazo ficam no banco.
  recuperacaoTokenHash String?  @unique @map("recuperacao_token_hash")
  recuperacaoExpiraEm DateTime? @map("recuperacao_expira_em")
  recuperacaoSolicitadaEm DateTime? @map("recuperacao_solicitada_em")
  recuperacaoTentativas Int @default(0) @map("recuperacao_tentativas")
  // Incrementar esta versão invalida as sessões emitidas antes da troca de senha.
  versaoSessao    Int           @default(0) @map("versao_sessao")
  provedorAuth    String        @default("LOCAL") @map("provedor_auth")
  googleSubject   String?       @unique @map("google_subject")
  cadastroConcluido Boolean     @default(true) @map("cadastro_concluido")
  fotoUrl         String?       @map("foto_url")
  nivel           String        @default("Cliente")
  ativo           Boolean       @default(true)
  atendimento     Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  agendamentos    Agendamento[]

  @@map("usuarios")
}

// Profissionais atendem agendamentos e possuem blocos de disponibilidade por dia da semana.
model Profissional {
  id                String                       @id @default(uuid())
  nome              String
  telefone          String?
  email             String?                      @unique
  especialidade     String?
  ativo             Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  agendamentos      Agendamento[]
  disponibilidades  DisponibilidadeProfissional[]

  @@map("profissionais")
}

// Catálogo de serviços; duração e preço são usados na seleção e no cálculo da agenda.
model Servico {
  id            String         @id @default(uuid())
  nome          String
  descricao     String?
  duracao       Int
  preco         Decimal        @db.Decimal(10, 2)
  ativo         Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  agendamentos  Agendamento[]

  @@map("servicos")
}

// Reserva que liga cliente, profissional e serviço a uma data, horário e status.
model Agendamento {
  id              String        @id @default(uuid())
  usuarioId       String        @map("usuario_id")
  profissionalId  String        @map("profissional_id")
  servicoId       String        @map("servico_id")
  data            String
  hora            String
  status          String        @default("PENDENTE")
  observacao      String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  profissional    Profissional  @relation(fields: [profissionalId], references: [id])
  servico         Servico       @relation(fields: [servicoId], references: [id])
  historicos      HistoricoAgendamento[]

  @@index([profissionalId, data, hora])
  @@map("agendamentos")
}

// Registra alterações de uma reserva para manter uma trilha de auditoria.
model HistoricoAgendamento {
  id              String       @id @default(uuid())
  agendamentoId   String       @map("agendamento_id")
  autorId         String       @map("autor_id")
  tipo            String
  dadosAnteriores Json?        @map("dados_anteriores")
  dadosNovos      Json?        @map("dados_novos")
  createdAt       DateTime     @default(now()) @map("created_at")
  agendamento     Agendamento  @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@map("historicos_agendamentos")
}

// Cada linha representa um bloco de 30 minutos em que um profissional pode atender.
model DisponibilidadeProfissional {
  id              String        @id @default(uuid())
  profissionalId  String        @map("profissional_id")
  diaSemana       Int           @map("dia_semana")
  hora            String
  profissional    Profissional  @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, diaSemana, hora])
  @@map("profissionais_disponibilidades")
}

// Dias em que novos agendamentos devem ser ocultados por decisão administrativa.
model BloqueioData {
  id        String   @id @default(uuid())
  data      String   @unique @db.VarChar(10)
  motivo    String   @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bloqueios_datas")
}

// Dados de contato e regras gerais exibidas ou aplicadas pela barbearia.
model Configuracao {
  id                String    @id @default(uuid())
  nome              String    @default("Barbearia")
  email             String    @default("contato@barbearia.com")
  telefoneWhatsApp  String?   @map("telefone_whatsapp")
  telefoneFixo      String?   @map("telefone_fixo")
  endereco          String?
  logo              String?
  instagram         String?
  tipoComissao      String?   @map("tipo_comissao")
  textoRodape       String?   @map("texto_rodape")
  imgBanner         String?   @map("img_banner")
  quantidadeCartoes Int?      @map("quantidade_cartoes")
  textoFidelidade   String?   @map("texto_fidelidade")
  antecedenciaCancelamentoHoras Int @default(24) @map("antecedencia_cancelamento_horas")
  antecedenciaAgendamentoMinutos Int @default(30) @map("antecedencia_agendamento_minutos")
  toleranciaAtrasoMinutos       Int @default(0) @map("tolerancia_atraso_minutos")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("config")
}
