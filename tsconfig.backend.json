{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/backend",
    "rootDir": "./src/backend",
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true
  },
  "include": [
    "src/backend/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
