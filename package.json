{
  "name": "sistema-barbearia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=300 concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 5000",
    "dev:backend": "nodemon --legacy-watch --watch src/backend --ext js --exec node src/backend/server.js",
    "start": "node src/backend/server.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "find src/backend -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-auth-library": "10.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "pg": "8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "2.6.0",
    "wouter": "3.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "10.8.0",
    "nodemon": "^3.1.14",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "supertest": "^7.3.0",
    "vite": "^5.4.3",
    "vitest": "^4.1.11"
  }
}
