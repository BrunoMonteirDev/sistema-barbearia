{
  "name": "sistema-barbearia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 5000",
    "dev:backend": "tsx watch src/backend/server.ts",
    "start": "tsx src/backend/server.ts",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run typecheck:frontend && vite build",
    "build:backend": "npm run typecheck:backend",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-auth-library": "10.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "pg": "8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "2.6.0",
    "wouter": "3.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "10.8.0",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "supertest": "^7.3.0",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^5.4.3",
    "vitest": "^4.1.11"
  }
}
